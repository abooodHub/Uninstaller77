// Exact known historical artifacts; do not replace with a name-only check.
function IsKnownLegacyHash(const Name, Hash: String): Boolean;
begin
  Result := False;
  if CompareText(Name, 'WinUninstaller.exe') = 0 then Result :=
      (CompareText(Hash, '014DA8CD549809C0D2427C8D78EBFB11F02DE56224B0F1711CFE0A48B398024A') = 0) or
      (CompareText(Hash, '10FAA3B77D648548735D74618922E16E7D6B53A9ADC7FCC829B0C3BF23D30D08') = 0) or
      (CompareText(Hash, '1F488E75C08F906B9B8BCFF31C1F8173D61ADDF25F0F48177BF0A9AA7A670FF4') = 0) or
      (CompareText(Hash, '2D8C32D9DF44B74A9D401E6E5522F7C1FEDB1A3A129CDEB260749D28C199A373') = 0) or
      (CompareText(Hash, '5CDBA5AD4ECE4959DF6257AE3DCCDCB0CA6BF99022A5667097A7BEE83787EC67') = 0) or
      (CompareText(Hash, '6B2F84E55C805907F3064B2BEC26536E15053CE264CD468D04933D490140ACA2') = 0) or
      (CompareText(Hash, 'AFAC9A65D5C76892F275E32BE66D1A35362AC68FE259BFDDFEBD67913B05A318') = 0);
  if CompareText(Name, 'WinUninstaller.dll') = 0 then Result :=
      (CompareText(Hash, '0514E6DC77D84ED8135133851BBB93D4625BC6DB5CFAF7A0DAA042BB1CB63561') = 0) or
      (CompareText(Hash, '46845BE173B8F1A175CC6DD72962E15E47BBA8AF258334179F237CA2821A2A90') = 0) or
      (CompareText(Hash, '594E199F487B81BF00000EE570E786A7CB524C2592AE509C7D6D40F6E891FE74') = 0) or
      (CompareText(Hash, 'A10BB9D5BD6C197B3CD418C40A581620B9746F88FCD7754419C6E3C0A77378B7') = 0) or
      (CompareText(Hash, 'A7911FDA9AAAFAB2493B6C4ECE375F3CC66DC967C62B5F8BE854CC6822882E6E') = 0) or
      (CompareText(Hash, 'DEEE983FFBF0B86E90636814B6855ACF60949CDAC668D40A28219CD4A7DB9065') = 0) or
      (CompareText(Hash, 'F7AA82AA1F8B7CB7465D37D3BFFC8B6E8D296F0A9971A19B1E070DAC9082F758') = 0);
  if CompareText(Name, 'WinUninstaller.deps.json') = 0 then Result :=
      (CompareText(Hash, '1E75D360F49AE10A41F7900C43922CF14BCB1895EAC6A38FC52EB96DF43C9B7C') = 0) or
      (CompareText(Hash, '3763BA47D640A9D2BE6CF9C822084908C5A90B2B199BFE11E8B4D15C5AB519F5') = 0) or
      (CompareText(Hash, '4B2E904C169E91B63FF70CBA11976091FCFBA9D5E328AE3A1DA93CAE131AA923') = 0) or
      (CompareText(Hash, '7A120677EB7C6CCEF250898BC5A3C33295F263C05763797C5B8DC21B54122A49') = 0) or
      (CompareText(Hash, 'B823BA972C018544BF6D0E537DCB4A234ADF311B6044E18977CE2CDADEF957D2') = 0) or
      (CompareText(Hash, 'E93C6F68B2F026A695BA3CD7E0FDAD0F15166C9025AA8FA16D4D53A2C99321F8') = 0) or
      (CompareText(Hash, 'FF79D611867056FD009DB4C3576FF79F6D29186FDA8209E7034D5B16BF1AE686') = 0);
  if CompareText(Name, 'WinUninstaller.runtimeconfig.json') = 0 then Result :=
      (CompareText(Hash, 'B7AB6A0AD18CF1280AD75C8E6D0DF62D06C84D62DC69351E49C04AFD3E218EB2') = 0);
end;
