<Project>
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Keep historical/fixture projects on the SDK defaults, while the shipping
         application must remain clean under the full recommended analyzer set. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisLevel Condition="'$(MSBuildProjectName)' == 'WinUninstaller'">latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
