<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:WinUninstaller.Converters"
    xmlns:models="clr-namespace:WinUninstaller.Models"
    xmlns:vm="clr-namespace:WinUninstaller.ViewModels">

    <!-- ============================================================ -->
    <!-- CONVERTERS                                                    -->
    <!-- ============================================================ -->
    <conv:NullImageConverter x:Key="NullImageConverter"/>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:InverseBooleanConverter x:Key="InverseBool"/>
    <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>

    <!-- ============================================================ -->
    <!-- Fluent-inspired graphite palette                              -->
    <!-- ============================================================ -->
    <SolidColorBrush x:Key="BgBase"      Color="#101418"/>
    <SolidColorBrush x:Key="BgMantle"    Color="#171D23"/>
    <SolidColorBrush x:Key="BgCrust"     Color="#0B0F13"/>
    <SolidColorBrush x:Key="BgSurface0"  Color="#222B33"/>
    <SolidColorBrush x:Key="BgSurface1"  Color="#35424C"/>
    <SolidColorBrush x:Key="BgSurface2"  Color="#53616D"/>
    <SolidColorBrush x:Key="FgText"      Color="#F3F7FA"/>
    <SolidColorBrush x:Key="FgSubtext"   Color="#CCD6DD"/>
    <SolidColorBrush x:Key="FgOverlay"   Color="#9AAAB5"/>
    <SolidColorBrush x:Key="AccentBlue"  Color="#73C6F4"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#83D6B0"/>
    <SolidColorBrush x:Key="AccentRed"   Color="#F0999D"/>
    <SolidColorBrush x:Key="AccentYellow" Color="#F5CE83"/>
    <SolidColorBrush x:Key="AccentMauve" Color="#C7AEF5"/>
    <SolidColorBrush x:Key="AccentPeach" Color="#F2B994"/>
    <SolidColorBrush x:Key="AccentTeal"  Color="#7ED9D2"/>

    <Style x:Key="MetricCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgSurface0}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BgSurface1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,13"/>
    </Style>
    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="10"/>
    </Style>
    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FgText}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="25"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style x:Key="MetricCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FgOverlay}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>

    <!-- ============================================================ -->
    <!-- BASE STYLES                                                   -->
    <!-- ============================================================ -->
    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource BgBase}"/>
        <Setter Property="Foreground" Value="{StaticResource FgText}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable Display"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource FgText}"/>
        <Setter Property="FontFamily" Value="Segoe UI, Segoe UI Variable Display"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource BgSurface0}"/>
        <Setter Property="Foreground" Value="{StaticResource FgText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BgSurface1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBlue}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource AccentBlue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource FgText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource FgText}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <!-- ============================================================ -->
    <!-- BUTTON STYLES                                                 -->
    <!-- ============================================================ -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBlue}"/>
        <Setter Property="Foreground" Value="{StaticResource BgBase}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            TextElement.Foreground="{TemplateBinding Foreground}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#A6C8FF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource AccentRed}"/>
        <Setter Property="Foreground" Value="#11111B"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FF9CB8"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource FgSubtext}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BgSurface1}"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgSurface0}"/>
                            <Setter Property="Foreground" Value="{StaticResource FgText}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BgSurface2}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- ============================================================ -->
    <!-- SIDEBAR NAV BUTTON                                            -->
    <!-- ============================================================ -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource FgSubtext}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Margin="6,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource BgSurface0}"/>
                            <Setter Property="Foreground" Value="{StaticResource FgText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- MODAL OVERLAY BACKDROP & CARD                                -->
    <!-- ============================================================ -->
    <Style x:Key="ModalOverlay" TargetType="Border">
        <Setter Property="Background" Value="#E611111B"/>
        <Setter Property="Panel.ZIndex" Value="100"/>
    </Style>

    <Style x:Key="ModalCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgMantle}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BgSurface1}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ -->
    <!-- BADGE PILL                                                    -->
    <!-- ============================================================ -->
    <Style x:Key="BadgePill" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Background" Value="{StaticResource BgSurface0}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BgSurface1}"/>
    </Style>

    <!-- ============================================================ -->
    <!-- LIST ITEM TEMPLATE                                            -->
    <!-- ============================================================ -->
    <DataTemplate x:Key="AppListItemTemplate">
        <Border Background="Transparent"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource BgSurface0}"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34"/>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*" MinWidth="180"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="164"/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Column="0" IsChecked="{Binding IsBatchSelected, UpdateSourceTrigger=PropertyChanged}"
                          HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Select for batch removal"/>

                <!-- Icon (32x32) -->
                <Image Grid.Column="1"
                       Width="32" Height="32"
                       Source="{Binding IconImage, Converter={StaticResource NullImageConverter}}"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Stretch="Uniform"
                       VerticalAlignment="Center"/>

                <!-- Name & Badges -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,10,0">
                    <TextBlock Text="{Binding Name}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Border Style="{StaticResource BadgePill}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding Architecture}"
                                       FontSize="10"
                                       Foreground="{StaticResource AccentBlue}"/>
                        </Border>
                        <Border Style="{StaticResource BadgePill}" Margin="0,0,6,0">
                            <TextBlock Text="{Binding TypeDisplay}"
                                       FontSize="10"
                                       Foreground="{StaticResource AccentMauve}"/>
                        </Border>
                        <TextBlock Text="{Binding Publisher}"
                                   Foreground="{StaticResource FgOverlay}"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>

                <!-- Version -->
                <TextBlock Grid.Column="3" Text="{Binding Version}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource FgSubtext}"
                           TextTrimming="CharacterEllipsis"
                           Margin="4,0"/>

                <!-- Size -->
                <TextBlock Grid.Column="4"
                           Text="{Binding SizeDisplay}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource FgOverlay}"
                           Margin="4,0"/>

                <!-- Install Date -->
                <TextBlock Grid.Column="5"
                           Text="{Binding DisplayInstallDate}"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource FgOverlay}"
                           FontSize="11"
                           Margin="4,0"/>

                <!-- Action buttons -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{Binding DataContext.DetailsActionLabel, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Style="{StaticResource InfoButton}"
                            MinWidth="68" Height="30" Margin="0,0,6,0"
                            Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"/>

                    <Button Content="{Binding DataContext.UninstallActionLabel, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            Style="{StaticResource DangerButton}"
                            FontSize="11" MinWidth="78" Height="30" Padding="10,4"
                            Command="{Binding DataContext.PromptUninstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ============================================================ -->
    <!-- LISTBOX ITEM CONTAINER STYLE (removes default highlight)     -->
    <!-- ============================================================ -->
    <Style x:Key="AppListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BgSurface0}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BgSurface1}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
