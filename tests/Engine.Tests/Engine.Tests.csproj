<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Uninstaller77.EngineTests</AssemblyName>
    <StartupObject>EngineTestsProgram</StartupObject>
    <DefineConstants>$(DefineConstants);ENGINE_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- The same live engine sources; no copy of the shipping algorithms. -->
    <Compile Include="../../app/WinUninstaller/Services/*.cs" Link="Services/%(Filename)%(Extension)" />
    <Compile Include="../../app/WinUninstaller/Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../../app/WinUninstaller/ViewModels/*.cs" Link="ViewModels/%(Filename)%(Extension)" />
    <Compile Include="../retired/Engineering/**/*.cs" Link="Retired/%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="../../app/WinUninstaller/Resources/Strings.*.json" Link="Resources/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
  </ItemGroup>
</Project>
