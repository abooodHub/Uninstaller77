<UserControl x:Class="WinUninstaller.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinUninstaller.ViewModels"
             Background="{StaticResource BgBase}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== HEADER ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource BgMantle}"
                Padding="22,14"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource BgSurface0}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock FontSize="18" FontWeight="Bold" Text="{Binding HistoryTitle}"/>
                    <TextBlock Foreground="{StaticResource FgOverlay}" FontSize="12"
                               Text="{Binding HistoryDescription}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="{Binding ShowTestRecordsLabel}" IsChecked="{Binding ShowTestRecords}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button Content="{Binding RefreshLabel}"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"
                            Command="{Binding LoadHistoryCommand}"/>

                    <Button Content="{Binding MoreActionsLabel}" Style="{StaticResource GhostButton}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding PlacementTarget.Tag.ClearHistoryLabel, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Command="{Binding PlacementTarget.Tag.ClearAllHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Button.Tag><Binding/></Button.Tag>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== COLUMN HEADERS ===== -->
        <Border Grid.Row="1" Background="{StaticResource BgMantle}"
                Padding="16,6"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource BgSurface0}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"/>
                <TextBlock Grid.Column="1" Text="{Binding ApplicationLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0"/>
                <TextBlock Grid.Column="2" Text="{Binding InstallerTypeLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="{Binding ResultLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="{Binding ResidualStatusLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="5" Text="{Binding DateTimeLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="6" Text="{Binding ActionsLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,6,0"/>
            </Grid>
        </Border>

        <!-- ===== CONTENT AREA ===== -->
        <Grid Grid.Row="2">
            <!-- Empty State -->
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="🗓" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding NoHistoryLabel}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource FgText}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,0"/>
                <TextBlock Text="{Binding HistoryHintLabel}"
                           FontSize="12"
                           Foreground="{StaticResource FgOverlay}"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- History List -->
            <ListBox ItemsSource="{Binding Records}"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
                        <Border Padding="16,10"
                                BorderThickness="0,0,0,1"
                                BorderBrush="{StaticResource BgSurface0}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*" MinWidth="160"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>

                                <!-- Retained Icon -->
                                <Image Grid.Column="0"
                                       Width="32" Height="32"
                                       Source="{Binding Icon, Converter={StaticResource NullImageConverter}}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center"/>

                                <!-- App & Publisher -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Publisher}"
                                               Foreground="{StaticResource FgOverlay}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Installer Type -->
                                <TextBlock Grid.Column="2" Text="{Binding InstallerType}"
                                           Foreground="{StaticResource AccentMauve}"
                                           FontSize="12"
                                           VerticalAlignment="Center"/>

                                <!-- Success / Result -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding StatusText}"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Success}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsLegacyTestRecord}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentYellow}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding OutcomeState}" Value="NotInstalled">
                                                    <Setter Property="Foreground" Value="{StaticResource FgOverlay}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Residual Status -->
                                <TextBlock Grid.Column="4" Text="{Binding ResidualStatus}"
                                           Foreground="{StaticResource FgSubtext}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <!-- Date & Time -->
                                <TextBlock Grid.Column="5" Text="{Binding Date}"
                                           Foreground="{StaticResource FgOverlay}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>

                                <!-- Details Button -->
                                <Button Grid.Column="6" Content="{Binding DataContext.DetailsActionLabel, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        Style="{StaticResource InfoButton}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ===== DETAILS MODAL ===== -->
            <Border Style="{StaticResource ModalOverlay}"
                    Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource ModalCard}" Width="550" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="40" Height="40"
                                   Source="{Binding SelectedItem.Icon, Converter={StaticResource NullImageConverter}}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                <TextBlock Text="{Binding SelectedItem.Name}" FontSize="15" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedItem.Publisher}" Foreground="{StaticResource FgOverlay}" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="{StaticResource BgSurface0}" Margin="0,0,0,14"/>

                        <!-- Details Rows -->
                        <Border Background="{StaticResource BgSurface0}" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding UninstallDateLabel, StringFormat={}{0}:}" Foreground="{StaticResource FgOverlay}" Margin="0,2"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.Date}" Margin="0,2"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding InstallerTypeLabel, StringFormat={}{0}:}" Foreground="{StaticResource FgOverlay}" Margin="0,2"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.InstallerType}" Foreground="{StaticResource AccentMauve}" Margin="0,2"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding ExitCodeLabel, StringFormat={}{0}:}" Foreground="{StaticResource FgOverlay}" Margin="0,2"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.Record.ExitCode}" Margin="0,2"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding ResidualCleanupLabel, StringFormat={}{0}:}" Foreground="{StaticResource FgOverlay}" Margin="0,2"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.ResidualStatus}" Foreground="{StaticResource AccentGreen}" Margin="0,2"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding RetainedIconLabel, StringFormat={}{0}:}" Foreground="{StaticResource FgOverlay}" Margin="0,2"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.Record.CachedIconPath}" FontSize="10" Foreground="{StaticResource FgOverlay}" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding ExecutionNotesLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedItem.Notes, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Height="80"
                                 FontSize="11"
                                 Margin="0,0,0,18"/>

                        <!-- Close -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding CloseLabel}" Style="{StaticResource GhostButton}" Padding="16,6" Command="{Binding CloseDetailsCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
