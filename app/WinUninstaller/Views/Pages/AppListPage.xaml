<UserControl x:Class="WinUninstaller.Views.Pages.AppListPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WinUninstaller.ViewModels"
             xmlns:models="clr-namespace:WinUninstaller.Models"
             Background="{StaticResource BgBase}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== TOP HEADER ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource BgMantle}"
                Padding="26,22,26,20"
                BorderThickness="0,0,0,1"
                BorderBrush="{StaticResource BgSurface0}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title & Filter Stats -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource FgText}" Text="{Binding PageTitle}">
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Foreground="{StaticResource FgOverlay}" FontSize="12">
                            <Run Text="{Binding FilteredCount, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding ShownLabel, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding TotalCount, Mode=OneWay}"/>
                            <Run Text=" "/>
                            <Run Text="{Binding RegisteredAppsLabel, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Actions: Refresh -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding RefreshLabel}"
                            Style="{StaticResource GhostButton}"
                            Margin="0,0,8,0"
                            Command="{Binding LoadAppsCommand}"/>


                </StackPanel>

            </Grid>
        </Border>

        <!-- ===== SEARCH BAR & SORTING CONTROLS ===== -->
        <Border Grid.Row="1" Padding="18,10" Background="{StaticResource BgBase}" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BgSurface0}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input with placeholder -->
                <Grid Grid.Column="0" Margin="0,0,14,0">
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="13"/>
                    <TextBlock IsHitTestVisible="False"
                               Text="{Binding SearchPlaceholder}"
                               Foreground="{StaticResource FgOverlay}"
                               FontSize="13"
                               Margin="12,7,0,0"
                               VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SearchText}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Sort Mode Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="{Binding SelectVisibleLabel}" IsChecked="{Binding IsAllVisibleSelected}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding SelectedCount, Mode=OneWay}" VerticalAlignment="Center" Foreground="{StaticResource AccentBlue}" Margin="0,0,5,0"/>
                    <Button Content="{Binding UninstallSelectedLabel}" Style="{StaticResource DangerButton}" Margin="0,0,10,0"
                            IsEnabled="{Binding HasSelectedApps}"
                            Command="{Binding UninstallSelectedCommand}"/>
                    <TextBlock Text="{Binding SortLabel}" Foreground="{StaticResource FgOverlay}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button Content="{Binding SortNameLabel}" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Command="{Binding SetSortCommand}" CommandParameter="NameAsc"/>
                    <Button Content="{Binding SortSizeLabel}" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Command="{Binding SetSortCommand}" CommandParameter="SizeDesc"/>
                    <Button Content="{Binding SortDateLabel}" Style="{StaticResource GhostButton}" Margin="0,0,4,0" Command="{Binding SetSortCommand}" CommandParameter="DateDesc"/>
                    <Button Content="{Binding SortPublisherLabel}" Style="{StaticResource GhostButton}" Command="{Binding SetSortCommand}" CommandParameter="PublisherAsc"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== MAIN VIEW (LIST OR GRID) ===== -->
        <Grid Grid.Row="2">
            <!-- List View with Column Header -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Column Headers -->
                <Border Grid.Row="0" Background="{StaticResource BgMantle}"
                        Padding="14,6,14,6"
                        BorderThickness="0,0,0,1"
                        BorderBrush="{StaticResource BgSurface0}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*" MinWidth="180"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="164"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsAllVisibleSelected}" VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="Select all visible applications"/>
                        <TextBlock Grid.Column="2" Text="{Binding ApplicationColumnLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11" FontWeight="SemiBold" Margin="10,0,0,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding VersionColumnLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11" FontWeight="SemiBold" Margin="4,0"/>
                        <TextBlock Grid.Column="4" Text="{Binding SizeColumnLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11" FontWeight="SemiBold" Margin="4,0"/>
                        <TextBlock Grid.Column="5" Text="{Binding InstalledColumnLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11" FontWeight="SemiBold" Margin="4,0"/>
                        <TextBlock Grid.Column="6" Text="{Binding ActionsColumnLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,12,0"/>
                    </Grid>
                </Border>

                <!-- Virtualized ListBox -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Apps}"
                         SelectedItem="{Binding SelectedApp}"
                         ItemTemplate="{StaticResource AppListItemTemplate}"
                         ItemContainerStyle="{StaticResource AppListBoxItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Grid>

            <!-- Empty Search State -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding FilteredCount}" Value="0"/>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="🔍" FontSize="42" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding NoMatchesLabel}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource FgText}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding SearchHintLabel}" FontSize="12" Foreground="{StaticResource FgOverlay}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Loading Spinner / Overlay -->
            <Border Background="#D91E1E2E"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                    <TextBlock Text="{Binding ScanAppsLabel}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <ProgressBar Height="4" IsIndeterminate="{Binding ShowAnimatedProgress}" Foreground="{StaticResource AccentBlue}"
                                 Background="{StaticResource BgSurface0}" Margin="0,0,0,14"/>
                    <ItemsControl>
                        <Border Background="{StaticResource BgSurface0}" CornerRadius="5" Height="44" Margin="0,3"/>
                        <Border Background="{StaticResource BgSurface0}" CornerRadius="5" Height="44" Margin="0,3"/>
                        <Border Background="{StaticResource BgSurface0}" CornerRadius="5" Height="44" Margin="0,3"/>
                        <Border Background="{StaticResource BgSurface0}" CornerRadius="5" Height="44" Margin="0,3"/>
                    </ItemsControl>
                    <TextBlock Text="{Binding ScanRegistrationsLabel}"
                               FontSize="11" Foreground="{StaticResource FgOverlay}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- ===== MODAL 1: APPLICATION DETAILS ===== -->
            <Border Style="{StaticResource ModalOverlay}"
                    Visibility="{Binding IsDetailsOpen, Converter={StaticResource BoolToVis}}">
                <Border x:Name="DetailsCard" Style="{StaticResource ModalCard}" Width="650" MaxHeight="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Width="48" Height="48"
                                   Source="{Binding DetailsApp.IconImage, Converter={StaticResource NullImageConverter}}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="{Binding DetailsApp.Name}" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DetailsApp.Publisher}" Foreground="{StaticResource FgOverlay}" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- Body (Details) -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                            <StackPanel>
                                <Border Background="{StaticResource BgSurface0}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding DetailsVersionLabel, StringFormat={}{0}:}" Foreground="{StaticResource FgOverlay}" Margin="0,3"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DetailsApp.Version}" FontWeight="SemiBold" Margin="0,3"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ArchitectureLabel, StringFormat={}{0}:}" Foreground="{StaticResource FgOverlay}" Margin="0,3"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DetailsApp.Architecture}" Margin="0,3"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding InstallerEngineLabel, StringFormat={}{0}:}" Foreground="{StaticResource FgOverlay}" Margin="0,3"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DetailsApp.TypeDisplay}" Foreground="{StaticResource AccentMauve}" Margin="0,3"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding EstimatedSizeLabel, StringFormat={}{0}:}" Foreground="{StaticResource FgOverlay}" Margin="0,3"/>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding DetailsApp.SizeDisplay}" Margin="0,3"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding InstallDateLabel, StringFormat={}{0}:}" Foreground="{StaticResource FgOverlay}" Margin="0,3"/>
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DetailsApp.DisplayInstallDate}" Margin="0,3"/>
                                    </Grid>
                                </Border>

                                <!-- Locations -->
                                <TextBlock Text="{Binding InstallLocationLabel}" FontWeight="SemiBold" Margin="0,6,0,2"/>
                                <TextBox Text="{Binding DetailsApp.InstallLocation, Mode=OneWay}" IsReadOnly="True" FontSize="11" Margin="0,0,0,8"/>

                                <TextBlock Text="{Binding RegistryKeyLabel}" FontWeight="SemiBold" Margin="0,2,0,2"/>
                                <TextBox Text="{Binding DetailsApp.RegistryKeyPath, Mode=OneWay}" IsReadOnly="True" FontSize="11" Margin="0,0,0,8"/>

                                <TextBlock Text="{Binding UninstallCommandLabel}" FontWeight="SemiBold" Margin="0,2,0,2"/>
                                <TextBox Text="{Binding DetailsApp.SafeUninstallCommand, Mode=OneWay}" IsReadOnly="True" FontSize="11" Margin="0,0,0,8"/>

                                <TextBlock Text="{Binding QuietUninstallCommandLabel}" FontWeight="SemiBold" Margin="0,2,0,2"/>
                                <TextBox Text="{Binding DetailsApp.SafeQuietUninstallCommand, Mode=OneWay}" IsReadOnly="True" FontSize="11"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding CloseLabel}" Style="{StaticResource GhostButton}" Padding="18,6" Command="{Binding CloseDetailsCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ===== MODAL 2: UNINSTALL CONFIRMATION ===== -->
            <Border Style="{StaticResource ModalOverlay}"
                    Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVis}}">
                <Border x:Name="ConfirmCard" Style="{StaticResource ModalCard}" Width="520" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <!-- App Header -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Image Width="44" Height="44"
                                   Source="{Binding ConfirmApp.IconImage, Converter={StaticResource NullImageConverter}}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ConfirmUninstallLabel}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentRed}"/>
                                <TextBlock Text="{Binding ConfirmApp.Name}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding ConfirmApp.Publisher}" Foreground="{StaticResource FgOverlay}" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <Separator Background="{StaticResource BgSurface0}" Margin="0,0,0,14"/>

                        <TextBlock Text="{Binding UninstallModeLabel}" FontWeight="SemiBold" Margin="0,0,0,8"/>

                        <!-- Interactive Radio -->
                        <RadioButton GroupName="UninstallMode"
                                     IsChecked="{Binding IsQuietMode, Converter={StaticResource BoolToVis}, Mode=OneWay}"
                                     Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding StandardModeLabel}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StandardModeHintLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Silent Radio -->
                        <RadioButton GroupName="UninstallMode"
                                     IsChecked="{Binding IsQuietMode}"
                                     IsEnabled="{Binding ConfirmApp.HasQuietUninstall}"
                                     Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding QuietModeLabel}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding QuietModeHintLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11"/>
                            </StackPanel>
                        </RadioButton>

                        <!-- Deep Scan Option -->
                        <Border Background="{StaticResource BgSurface0}" CornerRadius="6" Padding="12,10" Margin="0,0,0,20">
                            <CheckBox IsChecked="{Binding AutoScanResiduals}">
                                <StackPanel Margin="6,0,0,0">
                                    <TextBlock Text="{Binding ReviewLeftoversLabel}" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}"/>
                                    <TextBlock Text="{Binding ReviewLeftoversHintLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <!-- Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="{Binding CancelLabel}" Style="{StaticResource GhostButton}" Padding="16,7" Margin="0,0,8,0" Command="{Binding CancelConfirmCommand}"/>
                            <Button Grid.Column="2" Content="{Binding UninstallNowLabel}" Style="{StaticResource DangerButton}" Padding="18,7" Command="{Binding ConfirmAndExecuteUninstallCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Border>

            <!-- ===== MODAL 3: QUEUE STATUS AND RESULTS ===== -->
            <Border Style="{StaticResource ModalOverlay}" Visibility="{Binding IsProgressOpen, Converter={StaticResource BoolToVis}}">
                <Border x:Name="ProgressCard" Style="{StaticResource ModalCard}" Width="780" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource BgSurface0}" Margin="0,0,12,0">
                                    <Image Source="{Binding ProgressApp.IconImage, Converter={StaticResource NullImageConverter}}" Width="28" Height="28"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProgressTitle}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource FgText}"/>
                                    <TextBlock Text="{Binding BatchStateLabel}" Foreground="{Binding BatchStatusBrush}" FontSize="12" Margin="0,3,0,0" Visibility="{Binding IsBatchQueue, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding ProgressApp.Name}" Foreground="{StaticResource FgOverlay}" FontSize="12" Margin="0,3,0,0" Visibility="{Binding IsBatchQueue, Converter={StaticResource InverseBoolToVis}}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="{Binding IsBatchQueue, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ElapsedLabel}" FontSize="10" Foreground="{StaticResource FgOverlay}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding ElapsedTime}" FontSize="13" FontFamily="Consolas" Foreground="{StaticResource FgText}" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Grid.Row="1" Margin="0,0,0,14">
                            <TextBlock Text="{Binding ProgressStatus}" Foreground="{StaticResource FgText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Height="8" Margin="0,10,0,5" Maximum="100" Value="{Binding BatchProgressPercent, Mode=OneWay}"
                                         IsIndeterminate="{Binding ShowAnimatedProgress}"
                                         Foreground="{Binding BatchStatusBrush}" Background="{StaticResource BgSurface0}"/>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CurrentStageLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11" Margin="0,0,6,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding CurrentStage, Mode=OneWay}" Foreground="{StaticResource FgOverlay}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="2" Text="{Binding BatchProgressText}" Foreground="{StaticResource FgOverlay}" FontSize="11" Visibility="{Binding IsBatchQueue, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,0,0,14" Visibility="{Binding IsBatchQueue, Converter={StaticResource BoolToVis}}">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource BgSurface0}" CornerRadius="8" Padding="12,9" Margin="0,0,7,0"><StackPanel><TextBlock Text="{Binding BatchProcessedLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11"/><TextBlock Text="{Binding BatchCompleted}" Foreground="{StaticResource FgText}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Grid.Column="1" Background="{StaticResource BgSurface0}" CornerRadius="8" Padding="12,9" Margin="0,0,7,0"><StackPanel><TextBlock Text="{Binding BatchSuccessfulLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11"/><TextBlock Text="{Binding BatchSuccessful}" Foreground="{StaticResource AccentGreen}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Grid.Column="2" Background="{StaticResource BgSurface0}" CornerRadius="8" Padding="12,9" Margin="0,0,7,0"><StackPanel><TextBlock Text="{Binding BatchFailedLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11"/><TextBlock Text="{Binding BatchFailed}" Foreground="{StaticResource AccentRed}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                                <Border Grid.Column="3" Background="{StaticResource BgSurface0}" CornerRadius="8" Padding="12,9"><StackPanel><TextBlock Text="{Binding BatchSkippedLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11"/><TextBlock Text="{Binding BatchSkipped}" Foreground="{StaticResource AccentPeach}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
                            </Grid>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding CurrentApplicationLabel}" Foreground="{StaticResource FgOverlay}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{Binding ProgressApp.IconImage, Converter={StaticResource NullImageConverter}}" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="{Binding ProgressApp.Name}" Foreground="{StaticResource FgText}" FontSize="13" TextTrimming="CharacterEllipsis"/></StackPanel>
                            </Grid>
                        </StackPanel>
                        <Grid Grid.Row="3">
                        <Border Background="{StaticResource BgCrust}" BorderBrush="{StaticResource BgSurface0}" BorderThickness="1" CornerRadius="8" Padding="8" MinHeight="120" Visibility="{Binding IsBatchQueue, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="{Binding ResultsLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource FgSubtext}" Margin="4,2,4,8"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding BatchResults}"><ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="4,3"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <Image Source="{Binding App.IconImage, Converter={StaticResource NullImageConverter}}" Width="20" Height="20" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding App.Name}" Foreground="{StaticResource FgText}" FontSize="12"/><TextBlock Text="{Binding Message}" Foreground="{StaticResource FgOverlay}" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding StateLabel}" Foreground="{Binding StateBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <Border Background="{StaticResource BgCrust}" BorderBrush="{StaticResource BgSurface0}" BorderThickness="1" CornerRadius="8" Padding="10" MinHeight="120" Visibility="{Binding IsBatchQueue, Converter={StaticResource InverseBoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding ProgressLogs}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11" Foreground="{StaticResource FgOverlay}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                        </Border>
                        </Grid>
                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                            <Button Content="{Binding StopAfterCurrentLabel}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding StopBatchCommand}" Visibility="{Binding IsBatchRunning, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsBatchQueue}"/>
                            <Button Content="{Binding CancelOperationLabel}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding CancelProgressCommand}" Visibility="{Binding IsBatchQueue, Converter={StaticResource InverseBoolToVis}}"/>
                            <Button Content="{Binding CloseLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding CloseProgressCommand}" Visibility="{Binding IsBatchRunning, Converter={StaticResource InverseBoolToVis}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>

            <!-- ===== MODAL 4: DEEP RESIDUAL CLEANUP ===== -->
            <Border Style="{StaticResource ModalOverlay}"
                    Visibility="{Binding IsResidualOpen, Converter={StaticResource BoolToVis}}">
                <Border x:Name="ResidualCard" Style="{StaticResource ModalCard}" Width="750" MaxHeight="620" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="{Binding ResidualTitleLabel}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentYellow}"/>
                            <TextBlock Text="{Binding ResidualStatusMessage}" Foreground="{StaticResource FgText}" Margin="0,3,0,0"/>
                            <TextBlock Foreground="{StaticResource FgOverlay}" FontSize="11" Margin="0,2,0,2">
                                <Run Text="{Binding ResidualScanStage, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding ResidualScannedLocations, Mode=OneWay}"/><Run Text=" "/><Run Text="{Binding CheckedLocationsLabel, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Foreground="{StaticResource AccentGreen}" FontSize="12" Margin="0,2,0,10">
                                <Run Text="{Binding ResidualSizeLabel, Mode=OneWay}"/>
                                <Run Text="{Binding TotalResidualSizeDisplay, Mode=OneWay}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>

                        <!-- Select All / Deselect Controls -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="{Binding SelectAllLabel}" Style="{StaticResource GhostButton}" FontSize="11" Padding="8,3" Margin="0,0,6,0" Command="{Binding SelectAllResidualsCommand}"/>
                            <Button Content="{Binding DeselectAllLabel}" Style="{StaticResource GhostButton}" FontSize="11" Padding="8,3" Command="{Binding DeselectAllResidualsCommand}"/>
                        </StackPanel>

                        <!-- Residual Items List -->
                        <Border Grid.Row="2" Background="{StaticResource BgSurface0}" BorderBrush="{StaticResource BgSurface1}" BorderThickness="1" CornerRadius="8" Padding="6">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding ResidualItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ResidualItem}">
                                            <Border Background="Transparent" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BgMantle}" Padding="8,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>

                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanClean}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                    <!-- Type Badge -->
                                                    <Border Grid.Column="1" Style="{StaticResource BadgePill}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding TypeDisplay}" FontSize="10" Foreground="{StaticResource AccentMauve}"/>
                                                    </Border>

                                                    <!-- Path & Reason -->
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                                                        <TextBlock Text="{Binding Path}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Reason}" FontSize="10" Foreground="{StaticResource FgOverlay}"/>
                                                    </StackPanel>

                                                    <!-- Size -->
                                                    <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}" FontSize="11" Foreground="{StaticResource FgOverlay}" VerticalAlignment="Center"/>

                                                    <!-- Confidence Badge -->
                                                    <Border Grid.Column="4" CornerRadius="3" Padding="4,2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#33A6E3A1"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Confidence}" Value="Medium">
                                                                        <Setter Property="Background" Value="#33F9E2AF"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Confidence}" Value="Low">
                                                                        <Setter Property="Background" Value="#33F38BA8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding ConfidenceDisplay}" FontSize="9" FontWeight="Bold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreen}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Confidence}" Value="Medium">
                                                                            <Setter Property="Foreground" Value="{StaticResource AccentYellow}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Confidence}" Value="Low">
                                                                            <Setter Property="Foreground" Value="{StaticResource AccentRed}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>

                        <!-- Backup Checkbox -->
                        <CheckBox Grid.Row="3" IsChecked="{Binding BackupRegistry}" Margin="0,12,0,14" IsEnabled="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding QuarantineNoticeLabel}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </CheckBox>

                        <!-- Action Buttons -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="1" Content="{Binding SkipResidualLabel}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Command="{Binding SkipResidualCleanupCommand}"/>
                            <Button Grid.Column="2" Content="{Binding MoveToQuarantineLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteResidualCleanupCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="3"
                Background="{StaticResource BgCrust}"
                Padding="18,6"
                BorderThickness="0,1,0,0"
                BorderBrush="{StaticResource BgSurface0}">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource FgOverlay}"
                       FontSize="11"/>
        </Border>
    </Grid>
</UserControl>
